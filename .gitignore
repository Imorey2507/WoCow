# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
build/
*.local

# Next.js (aggie-playground — the official app)
.next/
out/
next-env.d.ts

# pnpm artefacts. aggie-playground/ uses npm: its package-lock.json is
# authoritative. These appear only if somebody runs pnpm inside it locally, and
# must never be committed alongside the npm lockfile.
aggie-playground/pnpm-lock.yaml
aggie-playground/pnpm-workspace.yaml

# Environment — NEVER commit real keys
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
desktop.ini

# Vercel
.vercel

# Testing
coverage/

# TypeScript build info
*.tsbuildinfo
