# Browser-safe Supabase values. Row Level Security must remain enabled.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
CONTEXT_DEV_API_KEY=YOUR_CONTEXT_DEV_API_KEY
CRON_SECRET=GENERATE_A_LONG_RANDOM_SECRET
