# WoCow environment variables
#
# 1. Copy this file to `.env.local`:
#      cp .env.example .env.local
# 2. Fill in the two values from your Supabase project:
#      Supabase Dashboard -> your WoCow project -> Settings -> API
# 3. NEVER commit `.env.local`. It is already in .gitignore.
#
# These two values are safe to expose in the browser *because* Row Level
# Security (RLS) is enabled on every table. See supabase/migrations/.
# The `service_role` / secret key and the database password must NEVER
# appear in this file or anywhere in the repo.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
